<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sale.invoice.plan</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='invoicing_setting_container']" position="inside">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="invoice_plan_auto_create"
                >
                    <div class="o_setting_left_pane">
                        <field name="auto_create_invoices_on_confirm" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="auto_create_invoices_on_confirm" />
                        <div class="text-muted">
                            When enabled, draft invoices will be automatically
                            created from the invoice plan upon sale order confirmation.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
